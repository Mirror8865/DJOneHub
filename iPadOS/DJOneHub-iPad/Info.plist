<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>DJOneHub</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- 保活：系统按此白名单校验 BGTaskScheduler 注册的标识符，缺失会在注册时抛异常。 -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.djonehub.standby.refresh</string>
		<string>com.djonehub.standby.processing</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 仅放行本地网络，公网请求仍受 ATS 保护。 -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSContactsUsageDescription</key>
	<string>用于在拨号、最近通话和短信中显示联系人姓名，并支持从通讯录直接拨号。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于通过 USB 网络连接 QDC507 模块并控制电话、短信、4G、GPS 与 eSIM。</string>
	<!-- 首次接入页用它触发一次本地网络授权：未声明类型时 Bonjour 浏览会直接失败，
	     系统也就不会弹授权面板。App 自身不发布也不依赖 Bonjour 服务。 -->
	<key>NSBonjourServices</key>
	<array>
		<string>_djonehub._tcp</string>
	</array>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>开启“后台保活”后，App 使用后台定位让进程保持活跃，以便在熄屏或切到后台时仍能收到模块转发的来电与短信通知。App 不记录、不上传任何位置数据。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于开启“后台保活”，让 App 在后台保持活跃以接收来电与短信通知。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于通过已连接的 QDC507 模块进行双向语音通话，以及搜索框的语音输入。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于将语音输入识别为文字，填入联系人或短信搜索框。</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- CallKit 来电上报需要 VoIP 后台能力；媒体仍由 audio 模式保活。 -->
		<string>voip</string>
		<!-- 后台保活：不使用静音音频，改由定位更新把进程留在运行态。 -->
		<string>location</string>
		<!-- 进程被系统回收后，靠后台刷新任务重新拉起并补发通知。 -->
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
