# 本仓库只保留可审查、可重建的源码；发布包由私有 GitHub Release 承载。
.DS_Store

# 凭据、签名私钥与本地部署环境。
.release-keys/
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.mobileprovision

# 可再生成的依赖与构建产物。
node_modules/
build/
dist/
DerivedData/
*.xcarchive/
xcuserdata/
*.xcuserstate

# 绝不提交已签名应用、模块二进制或历史归档。
*.ipa
*.dmg
*.zip
*.djupdate
*.ko
*.armv7

# QDC507 Agent 的本地交叉编译产物与设备回滚备份。
module/module-agent/qdc507-agent
module/module-agent/qdc507-agent-go*
module/module-agent/compat-go*
module/module-agent/module-backups/
*.tar.gz
*.gz

# 仅本地暂存，待人工上传到 Private Release。
release-assets/*
